# TLS-terminating reverse proxy in front of nexo-api. Caddy provisions and
# renews the certificate automatically from Let's Encrypt the first time it
# starts, given a real DNS A/AAAA record pointing at this instance — there
# is no manual certbot step.
#
# Install: see "3. TLS" in deploy/aws/README.md — the @caddy/caddy COPR
# repository used by some guides does not publish a build for Amazon Linux
# 2023 (confirmed by trying it on a real deploy), so this installs the
# official static binary directly instead. Replace api.example.com below
# with your real domain, or an "<ip-con-guiones>.sslip.io" hostname if you
# don't have one yet (see the README for why that still gets a real cert).
#
# nexo-api itself binds only 127.0.0.1:8080 (see nexo-api.service's
# NEXO_BIND_ADDR) — Caddy is the only process with a public listener.

api.example.com {
	reverse_proxy 127.0.0.1:8080

	encode gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
	}

	log {
		output file /var/log/caddy/nexo-api-access.log
	}
}
